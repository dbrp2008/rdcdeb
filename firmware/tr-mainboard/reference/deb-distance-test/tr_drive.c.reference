#include "tr_drive.h"
#include "usart.h"
#include "can.h"
#include "rm_motor.h"
#include "tr_arm.h"
#include <math.h>

#define TR_LINE_MAX 20U
#define RM_GEAR_RATIO 19.2f /* M3508 P19: rotor rpm = wheel rpm * 19.2 */

#if TR_BACK_ON_CAN2
extern CAN_HandleTypeDef hcan2; /* generated by CubeMX when CAN2 is enabled; rm_motor.c supplies a placeholder otherwise */
#define BACK_BUS (&hcan2)
#else
#define BACK_BUS (&hcan1)
#endif

/* The bus each wheel's ESC is on. */
static CAN_HandleTypeDef *wheel_bus(int wheel_index) { return (wheel_index == TR_WHEEL_B) ? BACK_BUS : &hcan1; }

/* ESC ID (blink count set with the SET button) for each wheel, in the order FL, FR, B.
 * Blink 1 = left (front-left) wheel, blink 2 = right (front-right) wheel, blink 3 = back wheel. */
static const RM_Motor wheel_motor[TR_WHEEL_COUNT] = {RM_MOTOR_1, RM_MOTOR_2, RM_MOTOR_3};
static const float wheel_sign[TR_WHEEL_COUNT] = {TR_FL_SIGN, TR_FR_SIGN, TR_B_SIGN};

/* Wheel drive direction (unit vector) for wheels at 150, 30 and 270 degrees
 * around the robot (x = right, y = forward):  t = (-sin(phi), cos(phi)). */
static const float wheel_tx[TR_WHEEL_COUNT] = {-0.5f, -0.5f, 1.0f};
static const float wheel_ty[TR_WHEEL_COUNT] = {-0.8660254f, 0.8660254f, 0.0f};

/* ---- Receive side (filled from the UART interrupt) ---- */
static uint8_t rx_byte;
static char line_buf[TR_LINE_MAX];
static uint8_t line_len = 0;
static bool line_overflow = false;

/* Latest commands. Movement ratios are in hundredths (-100..100). Each kind has its own timestamp so a stale one
 * is dropped by itself (e.g. the stick lines stop but the mechanism line keeps arriving). */
static volatile int16_t cmd_mx = 0, cmd_my = 0, cmd_rot = 0;
static volatile uint8_t cmd_speed = TR_SPEED_DEFAULT_LEVEL; /* 'S1'..'S5' */
static volatile uint32_t last_s_tick = 0;
static volatile bool s_seen = false;
static float cur_translate_rpm = TR_TRANSLATE_RPM, cur_rotate_rpm = TR_ROTATE_RPM;
static float cur_accel_rpm_s = TR_ACCEL_RPM_PER_S;
static volatile int8_t cmd_test = 0; /* encoder test: +1 = 1 m forward ('T+'), -1 = 1 m back ('T-'), 0 = 'T0' */
static volatile uint32_t last_t_tick = 0;
static volatile bool t_seen = false;
static volatile uint8_t cmd_hmode = 0; /* 'H0' = normal, 'H1' = heading-relative; 'HZ' zeroes the heading */
static volatile bool cmd_hzero = false;
static volatile uint32_t last_h_tick = 0;
static volatile bool h_seen = false;
static volatile char cmd_turn = '0'; /* 'YL' = 90 left, 'YR' = 90 right, 'YU' = 180, 'Y0' = none */
static volatile uint32_t last_y_tick = 0;
static volatile bool y_seen = false;
static volatile int8_t cmd_mech = 0; /* +1 = GC close (toward GRIP), -1 = GO open (toward OUT), 0 = GS stop */
static volatile uint32_t last_m_tick = 0, last_r_tick = 0, last_g_tick = 0, last_packet_tick = 0;
static volatile bool m_seen = false, r_seen = false, g_seen = false, packet_seen = false;

/* ---- Receive diagnostics (shown on the TFT) ---- */
static volatile uint32_t dbg_rx_bytes = 0;  /* every byte that arrived on USART1 */
static volatile uint32_t dbg_pkt_ok = 0;    /* valid command lines */
static volatile uint32_t dbg_pkt_bad = 0;   /* complete lines that were not valid (garbage / wrong format) */
static volatile uint32_t dbg_uart_err = 0;  /* UART hardware errors (framing/noise/overrun, usually wrong baud) */

/* ---- Control side (main loop only) ---- */
typedef struct {
  float setpoint_rotor_rpm; /* ramped target */
  float integ_a;            /* PID integral term, in amps */
  float prev_meas_rpm;
  float current_a;          /* last command */
} Wheel;

static Wheel wheel[TR_WHEEL_COUNT];
static uint32_t last_ctrl_tick = 0;
static TRDrive_Status status = {0};
static uint32_t last_hb_tick = 0;
static bool pid_reset_req = false; /* set when an automatic move ends: drop the stored push so the wheels stop promptly */

/* Parse a ratio "+0.50" / "-1.00": sign, one digit 0 or 1, '.', two digits, magnitude <= 1.00. Result in hundredths. */
static bool parse_ratio(const char *p, int16_t *out) {
  if ((p[0] != '+') && (p[0] != '-'))
    return false;
  if (p[1] < '0' || p[1] > '1' || p[2] != '.' || p[3] < '0' || p[3] > '9' || p[4] < '0' || p[4] > '9')
    return false;
  int mag = (p[1] - '0') * 100 + (p[3] - '0') * 10 + (p[4] - '0');
  if (mag > 100)
    return false;
  *out = (int16_t)((p[0] == '-') ? -mag : mag);
  return true;
}

/* Parse one of "-1", "0", "1" (old DRV format). Advances *p past it. Rejects anything else. */
static bool parse_axis(const char **p, int8_t *out) {
  bool neg = false;
  if (**p == '-') {
    neg = true;
    (*p)++;
  }
  if (**p == '0' && !neg) {
    *out = 0;
  } else if (**p == '1') {
    *out = neg ? -1 : 1;
  } else {
    return false;
  }
  (*p)++;
  return true;
}

/* Old fixed-step format "DRV:<vx>,<vy>,<w>,<a>": sets all four commands at once. */
static bool parse_legacy(const char *s) {
  const char *p = s;
  if (p[0] != 'D' || p[1] != 'R' || p[2] != 'V' || p[3] != ':')
    return false;
  p += 4;
  int8_t x, y, w, a;
  if (!parse_axis(&p, &x) || *p++ != ',')
    return false;
  if (!parse_axis(&p, &y) || *p++ != ',')
    return false;
  if (!parse_axis(&p, &w) || *p++ != ',')
    return false;
  if (!parse_axis(&p, &a) || *p != '\0')
    return false;
  uint32_t now = HAL_GetTick();
  cmd_mx = (int16_t)(x * 100);
  cmd_my = (int16_t)(y * 100);
  cmd_rot = (int16_t)(w * 100);
  cmd_mech = a;
  last_m_tick = last_r_tick = last_g_tick = last_packet_tick = now;
  m_seen = r_seen = g_seen = packet_seen = true;
  return true;
}

/* Strict parse of one line (no LF): "M+0.50/-0.25", "R-0.40", "GO", "GC", "GS", or the old DRV format. */
static bool parse_line(const char *s, uint8_t len) {
  uint32_t now = HAL_GetTick();
  if (len == 12U && s[0] == 'M' && s[6] == '/') {
    int16_t x, y;
    if (!parse_ratio(s + 1, &x) || !parse_ratio(s + 7, &y))
      return false;
    cmd_mx = x;
    cmd_my = y;
    last_m_tick = now;
    m_seen = true;
  } else if (len == 6U && s[0] == 'R') {
    int16_t z;
    if (!parse_ratio(s + 1, &z))
      return false;
    cmd_rot = z;
    last_r_tick = now;
    r_seen = true;
  } else if (len == 2U && s[0] == 'H') {
    if (s[1] == '0')
      cmd_hmode = 0;
    else if (s[1] == '1')
      cmd_hmode = 1;
    else if (s[1] == 'Z')
      cmd_hzero = true;
    else
      return false;
    last_h_tick = now;
    h_seen = true;
  } else if (len == 2U && s[0] == 'Y') {
    if (s[1] != '0' && s[1] != 'L' && s[1] != 'R' && s[1] != 'U')
      return false;
    cmd_turn = s[1];
    last_y_tick = now;
    y_seen = true;
  } else if (len == 2U && s[0] == 'S') {
    if (s[1] < '0' || s[1] > (char)('0' + TR_SPEED_LEVELS - 1))
      return false;
    cmd_speed = (uint8_t)(s[1] - '0' + 1); /* 'S0'..'S9' = level 1..10 */
    last_s_tick = now;
    s_seen = true;
  } else if (len == 2U && s[0] == 'T') {
    if (s[1] == '+')
      cmd_test = 1;
    else if (s[1] == '-')
      cmd_test = -1;
    else if (s[1] == '0')
      cmd_test = 0;
    else
      return false;
    last_t_tick = now;
    t_seen = true;
  } else if (len == 2U && s[0] == 'G') {
    if (s[1] == 'O')
      cmd_mech = -1;
    else if (s[1] == 'C')
      cmd_mech = 1;
    else if (s[1] == 'S')
      cmd_mech = 0;
    else
      return false;
    last_g_tick = now;
    g_seen = true;
  } else {
    return parse_legacy(s);
  }
  last_packet_tick = now;
  packet_seen = true;
  return true;
}

void HAL_UART_RxCpltCallback(UART_HandleTypeDef *huart) {
  if (huart != &huart1)
    return;

  char c = (char)rx_byte;
  dbg_rx_bytes++;
  if (c == '\n') {
    if (line_overflow) {
      dbg_pkt_bad++;
    } else if (line_len > 0) {
      line_buf[line_len] = '\0';
      if (parse_line(line_buf, line_len))
        dbg_pkt_ok++;
      else
        dbg_pkt_bad++;
    }
    line_len = 0;
    line_overflow = false;
  } else if (c != '\r') {
    if (line_len < TR_LINE_MAX - 1U) {
      line_buf[line_len++] = c;
    } else {
      line_overflow = true; /* garbage: drop this line, resync at next '\n' */
    }
  }

  HAL_UART_Receive_IT(&huart1, &rx_byte, 1);
}

/* After a UART error (overrun, noise) make sure reception keeps running. */
void HAL_UART_ErrorCallback(UART_HandleTypeDef *huart) {
  if (huart != &huart1)
    return;
  dbg_uart_err++;
  HAL_UART_Receive_IT(&huart1, &rx_byte, 1); /* harmless if already running */
}

void TRDrive_Init(void) {
  for (int i = 0; i < TR_WHEEL_COUNT; i++) {
    wheel[i].setpoint_rotor_rpm = 0.0f;
    wheel[i].integ_a = 0.0f;
    wheel[i].prev_meas_rpm = 0.0f;
    wheel[i].current_a = 0.0f;
  }
  last_ctrl_tick = HAL_GetTick();

  rm_can_init(&hcan1);
#if TR_BACK_ON_CAN2
  rm_can_init(&hcan2);
#endif
  TRArm_Init();
  HAL_UART_Receive_IT(&huart1, &rx_byte, 1);
}

static float clampf(float v, float lo, float hi) {
  if (v > hi) return hi;
  if (v < lo) return lo;
  return v;
}

/* Move cur toward target by at most max_step. */
static float slew(float cur, float target, float max_step) {
  float d = target - cur;
  if (d > max_step) return cur + max_step;
  if (d < -max_step) return cur - max_step;
  return target;
}

/* Inverse kinematics: command -> wheel-shaft rpm for FL, FR, B (before sign). */
static void mix(float vx, float vy, float w, float out_wheel_rpm[TR_WHEEL_COUNT]) {
  float ux = vx, uy = vy;
  float mag = sqrtf(ux * ux + uy * uy);
  if (mag > 1.0f) { /* diagonal presses go the same speed as straight ones; slower (fractional) commands are kept */
    ux /= mag;
    uy /= mag;
  }
  if (TR_INVERT_VX)
    ux = -ux;
  if (TR_INVERT_VY)
    uy = -uy;
  float omega_ccw = TR_INVERT_W ? w : -w; /* w > 0 means clockwise (before TR_INVERT_W) */

  float peak = 0.0f;
  for (int i = 0; i < TR_WHEEL_COUNT; i++) {
    out_wheel_rpm[i] = cur_translate_rpm * (wheel_tx[i] * ux + wheel_ty[i] * uy) + cur_rotate_rpm * omega_ccw;
    if (fabsf(out_wheel_rpm[i]) > peak)
      peak = fabsf(out_wheel_rpm[i]);
  }
  if (peak > TR_MAX_WHEEL_RPM) { /* scale all together so the direction stays right */
    float k = TR_MAX_WHEEL_RPM / peak;
    for (int i = 0; i < TR_WHEEL_COUNT; i++)
      out_wheel_rpm[i] *= k;
  }
}

static void control_step(float dt, bool link_ok, float vx, float vy, float w) {
  if (pid_reset_req) {
    for (int i = 0; i < TR_WHEEL_COUNT; i++)
      wheel[i].integ_a = 0.0f;
    pid_reset_req = false;
  }
  float target_wheel_rpm[TR_WHEEL_COUNT];
  mix(link_ok ? vx : 0.0f, link_ok ? vy : 0.0f, link_ok ? w : 0.0f, target_wheel_rpm);

  for (int i = 0; i < TR_WHEEL_COUNT; i++) {
    Wheel *wh = &wheel[i];
    float target_rotor = wheel_sign[i] * target_wheel_rpm[i] * RM_GEAR_RATIO;

    if (!link_ok) {
      wh->setpoint_rotor_rpm = 0.0f; /* link lost: target zero at once, no ramp */
    } else {
      wh->setpoint_rotor_rpm = slew(wh->setpoint_rotor_rpm, target_rotor,
                                    cur_accel_rpm_s * RM_GEAR_RATIO * dt);
    }

    float meas = (float)rm_get_actual_vel(wheel_bus(i), wheel_motor[i]) / RM_GEAR_RATIO; /* wheel-shaft rpm */
    float err = wh->setpoint_rotor_rpm / RM_GEAR_RATIO - meas;                       /* wheel-shaft rpm */

    float p = TR_KP * err;
    float i_new = wh->integ_a + TR_KI * err * dt;
    float d = -TR_KD * (meas - wh->prev_meas_rpm) / dt; /* on measurement: no kick when the target jumps */
    wh->prev_meas_rpm = meas;

    float u_unsat = p + i_new + d;
    float u = clampf(u_unsat, -TR_CURRENT_LIMIT_A, TR_CURRENT_LIMIT_A);
    /* Anti-windup: only keep integrating if we're not pushing further into saturation. */
    bool saturated_same_way = (u_unsat > TR_CURRENT_LIMIT_A && err > 0.0f) ||
                              (u_unsat < -TR_CURRENT_LIMIT_A && err < 0.0f);
    if (!saturated_same_way)
      wh->integ_a = clampf(i_new, -TR_CURRENT_LIMIT_A, TR_CURRENT_LIMIT_A);

    wh->current_a = u;
    rm_set_current_setpoint(wheel_bus(i), wheel_motor[i], u);

    status.target_rpm[i] = wh->setpoint_rotor_rpm / RM_GEAR_RATIO;
    status.actual_rpm[i] = meas;
    status.current_a[i] = u;
    status.temp_c[i] = rm_get_temperature(wheel_bus(i), wheel_motor[i]);
  }

  rm_ctrl_loop(&hcan1); /* send the current commands on CAN1 (front wheels) */
#if TR_BACK_ON_CAN2
  rm_ctrl_loop(&hcan2); /* ...and CAN2 (back wheel) */
#endif
}

/* ---------------- Encoder odometry + automatic 1 m move ---------------- */
#define ENC_COUNTS_PER_REV 8192.0f /* C620 encoder: 0..8191 per MOTOR-shaft revolution */
#define PI_F 3.14159265f

static bool enc_ready = false;
static int32_t enc_prev[2];       /* last raw reading: [0] = front-left, [1] = front-right */
static int32_t enc_pos[2];        /* unwrapped counts */
static uint32_t enc_last_change_tick = 0;

static float heading_deg = 0.0f;       /* clockwise positive, unwrapped */
static uint8_t turn_state = TR_TURN_IDLE;
static float turn_target_deg = 0.0f, turn_base_deg = 0.0f, turn_dir = 1.0f;
static uint32_t turn_start_tick = 0;
static char prev_tcmd = '0';

static uint8_t auto_state = TR_AUTO_IDLE;
static float auto_target_m = 0.0f;
static float auto_base_m = 0.0f;
static float auto_dist_m = 0.0f;
static uint32_t auto_start_tick = 0;
static int8_t prev_a = 0;

/* Track both front wheels' encoders, unwrapping the 0..8191 roll-over. Call every control step. */
static void enc_update(uint32_t now) {
  const uint16_t raw[2] = {rm_get_encoder(&hcan1, wheel_motor[TR_WHEEL_FL]),
                           rm_get_encoder(&hcan1, wheel_motor[TR_WHEEL_FR])};
  if (!enc_ready) {
    enc_prev[0] = raw[0];
    enc_prev[1] = raw[1];
    enc_last_change_tick = now;
    enc_ready = true;
    return;
  }
  bool changed = false;
  for (int i = 0; i < 2; i++) {
    int32_t d = (int32_t)raw[i] - enc_prev[i];
    if (d > 4095) d -= 8192;
    else if (d < -4095) d += 8192;
    if (d != 0) changed = true;
    enc_pos[i] += d;
    enc_prev[i] = raw[i];
  }
  if (changed)
    enc_last_change_tick = now;
}

/* Distance (metres) the robot has moved along its COMMANDED forward direction, since power-up.
 * For a pure forward move the wheels' model speeds are FL = -0.866 V and FR = +0.866 V, so
 * V = (FR - FL) / 2 / 0.866. */
static float forward_distance_m(void) {
  const float metres_per_count = (PI_F * TR_WHEEL_DIAMETER_M) / (ENC_COUNTS_PER_REV * RM_GEAR_RATIO);
  float fl = wheel_sign[TR_WHEEL_FL] * TR_ENCODER_SIGN * (float)enc_pos[0] * metres_per_count;
  float fr = wheel_sign[TR_WHEEL_FR] * TR_ENCODER_SIGN * (float)enc_pos[1] * metres_per_count;
  float d = (fr - fl) * 0.5f / 0.8660254f;
  return TR_INVERT_VY ? -d : d;
}

void TRDrive_Update(void) {
  uint32_t now = HAL_GetTick();
  if (now == last_ctrl_tick)
    return; /* run the loop once per millisecond */

  float dt = (float)(now - last_ctrl_tick) / 1000.0f;
  if (dt > 0.05f) dt = 0.05f; /* after a long stall, don't take a huge step */
  last_ctrl_tick = now;

  /* Snapshot the command the interrupt writes, so values and tick are consistent. */
  __disable_irq();
  int16_t mx = cmd_mx, my = cmd_my, mr = cmd_rot;
  int8_t mech = cmd_mech, tst = cmd_test;
  uint8_t spd = cmd_speed;
  uint8_t hmode = cmd_hmode;
  bool hzero = cmd_hzero;
  cmd_hzero = false;
  char tcmd = cmd_turn;
  uint32_t t_h = last_h_tick, t_y = last_y_tick;
  bool s_h = h_seen, s_y = y_seen;
  uint32_t t_s = last_s_tick;
  bool s_s = s_seen;
  uint32_t t_m = last_m_tick, t_r = last_r_tick, t_g = last_g_tick, t_t = last_t_tick, last = last_packet_tick;
  bool s_m = m_seen, s_r = r_seen, s_g = g_seen, s_t = t_seen, seen = packet_seen;
  __enable_irq();

  /* Each command expires on its own: a stale one counts as released. */
  if (!(s_m && (now - t_m) <= TR_LINK_TIMEOUT_MS)) { mx = 0; my = 0; }
  if (!(s_r && (now - t_r) <= TR_LINK_TIMEOUT_MS)) mr = 0;
  if (!(s_g && (now - t_g) <= TR_LINK_TIMEOUT_MS)) mech = 0;
  if (!(s_t && (now - t_t) <= TR_LINK_TIMEOUT_MS)) tst = 0;
  if (!(s_h && (now - t_h) <= TR_LINK_TIMEOUT_MS)) hmode = 0; /* no 'H' line: normal driving */
  if (!(s_y && (now - t_y) <= TR_LINK_TIMEOUT_MS)) tcmd = '0';
  if (!(s_s && (now - t_s) <= TR_LINK_TIMEOUT_MS)) spd = TR_SPEED_DEFAULT_LEVEL; /* no 'S' line: default speed */
  {
    static const float lv_t[TR_SPEED_LEVELS] = TR_SPEED_TRANSLATE_RPM;
    static const float lv_r[TR_SPEED_LEVELS] = TR_SPEED_ROTATE_RPM;
    if (spd < 1U || spd > TR_SPEED_LEVELS) spd = TR_SPEED_DEFAULT_LEVEL;
    cur_translate_rpm = lv_t[spd - 1U];
    cur_rotate_rpm = lv_r[spd - 1U];
    cur_accel_rpm_s = TR_ACCEL_RPM_PER_S;
    status.speed_level = spd;
  }
  bool link_ok = seen && ((now - last) <= TR_LINK_TIMEOUT_MS);
  int8_t x = (int8_t)((mx > 0) - (mx < 0)), y = (int8_t)((my > 0) - (my < 0)), w = (int8_t)((mr > 0) - (mr < 0)), a = mech;
  float fx = (float)mx / 100.0f, fy = (float)my / 100.0f, fw = (float)mr / 100.0f;
#if TR_BENCH_TEST == 1
  /* Bench drive: ignore the Controller. BTN1 = forward, BTN2 = back. */
  link_ok = true;
  x = 0;
  w = 0;
  a = 0;
  y = (int8_t)(btn_read(BTN1) ? 1 : 0) - (int8_t)(btn_read(BTN2) ? 1 : 0);
#elif TR_BENCH_TEST == 2
  /* Bench arm: ignore the Controller. BTN1 = toward GRIP, BTN2 = toward OUT. Wheels stay at 0. */
  link_ok = true;
  x = 0;
  y = 0;
  w = 0;
  a = (int8_t)(btn_read(BTN1) ? 1 : 0) - (int8_t)(btn_read(BTN2) ? 1 : 0);
#elif TR_BENCH_TEST == 3
  /* Bench both: BTN1 = wheels forward + arm toward GRIP, BTN2 = wheels back + arm toward OUT. */
  link_ok = true;
  x = 0;
  w = 0;
  y = (int8_t)(btn_read(BTN1) ? 1 : 0) - (int8_t)(btn_read(BTN2) ? 1 : 0);
  a = y;
#endif
#if TR_BENCH_TEST != 0
  fx = (float)x; fy = (float)y; fw = (float)w;
#endif
  {
    uint8_t m1 = 0, m2 = 0;
    for (int id = 0; id < 8; id++) {
      if (rm_get_temperature(&hcan1, (RM_Motor)id) != 0)
        m1 |= (uint8_t)(1U << id);
#if TR_BACK_ON_CAN2
      if (rm_get_temperature(&hcan2, (RM_Motor)id) != 0)
        m2 |= (uint8_t)(1U << id);
#endif
    }
    status.can1_ids = m1;
    status.can2_ids = m2;
  }
  status.link_ok = link_ok;
  status.rx_bytes = dbg_rx_bytes;
  status.pkt_ok = dbg_pkt_ok;
  status.pkt_bad = dbg_pkt_bad;
  status.uart_err = dbg_uart_err;
  status.vx = link_ok ? x : 0;
  status.vy = link_ok ? y : 0;
  status.w = link_ok ? w : 0;
  status.a = link_ok ? a : 0;
  status.move_x_pct = link_ok ? mx : 0;
  status.move_y_pct = link_ok ? my : 0;
  status.rot_pct = link_ok ? mr : 0;

  /* ---- Heading estimate from the three wheel speeds ---- */
  {
    float sum = 0.0f;
    for (int i = 0; i < TR_WHEEL_COUNT; i++)
      sum += wheel_sign[i] * (float)rm_get_actual_vel(wheel_bus(i), wheel_motor[i]) / RM_GEAR_RATIO;
    float rot_w_rpm = (TR_INVERT_W ? 1.0f : -1.0f) * (sum / 3.0f); /* + = the direction a positive R command turns */
    float rim_m_s = rot_w_rpm * (PI_F * TR_WHEEL_DIAMETER_M) / 60.0f;
    float omega_rad_s = rim_m_s / TR_ROBOT_RADIUS_M;
    heading_deg += TR_HEADING_SIGN * omega_rad_s * dt * (180.0f / PI_F);
    if (hzero)
      heading_deg = 0.0f;
  }
  {
    float wrapped = fmodf(heading_deg, 360.0f);
    if (wrapped > 180.0f) wrapped -= 360.0f;
    else if (wrapped < -180.0f) wrapped += 360.0f;
    status.heading_deg = (int16_t)wrapped;
  }
  status.heading_mode = (uint8_t)(hmode != 0U);

  /* ---- Enc test (original) ---- */
  enc_update(now);
  float cmd_x = fx, cmd_y = fy, cmd_w_now = fw;
#if TR_ENCODER_TEST
  {
    const bool manual = link_ok && (x != 0 || y != 0 || w != 0);
    const int8_t a_now = link_ok ? tst : 0; /* Controller button 5 / 6 */
    const float d_now = forward_distance_m();
    const bool was_running = (auto_state == TR_AUTO_RUN);

    if (auto_state == TR_AUTO_RUN) {
      const float travelled = d_now - auto_base_m;
      const float remaining = auto_target_m - travelled;
      const float dir = (auto_target_m >= 0.0f) ? 1.0f : -1.0f;
      auto_dist_m = travelled;
      if (!link_ok || manual) {
        auto_state = TR_AUTO_ABORT;
      } else if (fabsf(remaining) <= TR_AUTO_TOL_M || ((remaining * dir) < 0.0f && fabsf(remaining) < 0.05f)) {
        auto_state = TR_AUTO_DONE;
      } else if ((now - auto_start_tick) > TR_AUTO_TIMEOUT_MS) {
        auto_state = TR_AUTO_ABORT;
      } else if ((now - auto_start_tick) > 500U && (now - enc_last_change_tick) > 400U) {
        auto_state = TR_AUTO_NOFB; /* commanding motion but the encoders do not move: stop */
      } else {
        float f = fabsf(remaining) / TR_AUTO_DECEL_ZONE_M;
        if (f > TR_AUTO_MAX_FRAC) f = TR_AUTO_MAX_FRAC;
        if (f < TR_AUTO_MIN_FRAC) f = TR_AUTO_MIN_FRAC;
        cmd_x = 0.0f;
        cmd_w_now = 0.0f;
        cmd_y = (remaining > 0.0f) ? f : -f;
        cur_translate_rpm = TR_TRANSLATE_RPM; /* the automatic move ignores the speed level */
      }
    }
    if (auto_state != TR_AUTO_RUN) {
      if (was_running)
        pid_reset_req = true;
      auto_dist_m = d_now - auto_base_m; /* keep showing the distance while the robot settles after the move */
    }
    if (auto_state != TR_AUTO_RUN && !manual && a_now != 0 && prev_a == 0) { /* a fresh press of 5 or 8 */
      auto_state = TR_AUTO_RUN;
      auto_target_m = (a_now > 0) ? TR_AUTO_DISTANCE_M : -TR_AUTO_DISTANCE_M;
      auto_base_m = d_now;
      auto_dist_m = 0.0f;
      auto_start_tick = now;
    }
    prev_a = a_now;
    status.auto_state = auto_state;
    status.dist_mm = (int32_t)(auto_dist_m * 1000.0f);
  }
#endif

  /* ---- Heading-relative driving: the stick direction is relative to the heading at power-up / last zero ---- */
  if (hmode != 0U && link_ok && turn_state != TR_TURN_RUN && auto_state != TR_AUTO_RUN) {
    float th = heading_deg * (PI_F / 180.0f); /* robot turned clockwise by th: world "forward" is th counter-clockwise from its nose */
    float c = cosf(th), s = sinf(th);
    float nx = cmd_x * c - cmd_y * s;
    float ny = cmd_x * s + cmd_y * c;
    cmd_x = nx;
    cmd_y = ny;
  }

  /* ---- Turn moves (Controller buttons): 90 left, 90 right, 180, by the heading estimate ---- */
  {
    const bool manual_t = link_ok && (x != 0 || y != 0 || w != 0);
    if (turn_state == TR_TURN_RUN) {
      float remaining = turn_target_deg - heading_deg;
      if (!link_ok || manual_t) {
        turn_state = TR_TURN_ABORT;
      } else if (fabsf(remaining) <= TR_TURN_TOL_DEG || ((remaining * turn_dir) < 0.0f && fabsf(remaining) < 5.0f)) {
        turn_state = TR_TURN_DONE;
      } else if ((now - turn_start_tick) > TR_TURN_TIMEOUT_MS) {
        turn_state = TR_TURN_ABORT;
      } else if ((now - turn_start_tick) > 600U && fabsf(heading_deg - turn_base_deg) < 1.0f) {
        turn_state = TR_TURN_NOFB; /* commanded to turn but the wheels show no rotation: stop */
      } else {
        float f = fabsf(remaining) / TR_TURN_DECEL_DEG;
        if (f > TR_TURN_MAX_FRAC) f = TR_TURN_MAX_FRAC;
        if (f < TR_TURN_MIN_FRAC) f = TR_TURN_MIN_FRAC;
        cmd_x = 0.0f;
        cmd_y = 0.0f;
        cmd_w_now = TR_HEADING_SIGN * ((remaining > 0.0f) ? f : -f); /* a positive R turns the heading by TR_HEADING_SIGN */
        cur_rotate_rpm = TR_ROTATE_RPM;                              /* turns ignore the speed level */
        cur_accel_rpm_s = TR_TURN_ACCEL_RPM_PER_S;                  /* ...and ramp gently so the wheels don't slip */
      }
      if (turn_state != TR_TURN_RUN)
        pid_reset_req = true;
    }
    if (turn_state != TR_TURN_RUN && !manual_t && tcmd != '0' && prev_tcmd == '0' && auto_state != TR_AUTO_RUN && link_ok) {
      float delta = (tcmd == 'L') ? -90.0f : ((tcmd == 'R') ? 90.0f : 180.0f); /* clockwise positive */
      turn_state = TR_TURN_RUN;
      turn_base_deg = heading_deg;
      turn_target_deg = heading_deg + delta;
      turn_dir = (delta >= 0.0f) ? 1.0f : -1.0f;
      turn_start_tick = now;
    }
    prev_tcmd = tcmd;
    status.turn_state = turn_state;
  }

  control_step(dt, link_ok, cmd_x, cmd_y, cmd_w_now);

  /* Heartbeat back to the Controller (3 bytes, ~0.3 ms) so it can show whether the Bluetooth link carries data
   * in the MainBoard -> Controller direction. */
  if ((now - last_hb_tick) >= 100U) {
    last_hb_tick = now;
    static const uint8_t hb[3] = {'H', 'B', '\n'};
    HAL_UART_Transmit(&huart1, (uint8_t *)hb, sizeof(hb), 5);
  }

#if TR_ENCODER_TEST
  TRArm_Update(status.a); /* GC/GO/GS; link lost or no GO/GC => 0 => the arm just holds its position */
#else
  TRArm_Update(status.a);
#endif
  status.arm_us = TRArm_GetPulseUs();
}

void TRDrive_GetStatus(TRDrive_Status *out) {
  if (out)
    *out = status;
}
